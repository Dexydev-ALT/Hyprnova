// HyprNova :: RecommendationCard -- the two-up gradient cards under the hero.
//
// The reference app fills these with offers; ours carry REAL recommendations
// generated by the shell from the agent's own findings (dry-run on, sensors
// degraded, hardening drift, auto-respond off...). Gradient on Canvas (no
// effects import), opaque content: kicker, title, optional action button, and
// the dismiss "x" that only hides the card for this session.

import QtQuick
import QtQuick.Controls
import QtQuick.Layouts
import "../theme"
import "."

Rectangle {
    id: card

    signal actionClicked()
    signal dismissed()

    property string kicker: "SECURITY"
    property string title: ""
    property string actionLabel: ""
    property bool danger: false
    /// Session-only dismissal: persistence would need a state store, and a
    /// recommendation the operator dismissed once is still worth seeing after a
    /// reboot that changed the facts.
    property bool dismissedNow: false

    visible: !dismissedNow
    height: visible ? 132 : 0
    radius: 12
    color: "transparent"           // the Canvas paints the card body
    clip: true

    Canvas {
        id: body
        anchors.fill: parent
        renderStrategy: Canvas.Immediate
        onPaint: {
            var ctx = getContext("2d");
            ctx.reset();
            var r = 12;
            // rounded-rect path
            ctx.beginPath();
            ctx.moveTo(r, 0);
            ctx.lineTo(width - r, 0); ctx.quadraticCurveTo(width, 0, width, r);
            ctx.lineTo(width, height - r); ctx.quadraticCurveTo(width, height, width - r, height);
            ctx.lineTo(r, height); ctx.quadraticCurveTo(0, height, 0, height - r);
            ctx.lineTo(0, r); ctx.quadraticCurveTo(0, 0, r, 0);
            ctx.closePath();
            var a = card.danger ? "#8A2E3E" : Theme.recCardA;
            var b = card.danger ? "#5A1F2C" : Theme.recCardB;
            var grad = ctx.createLinearGradient(0, 0, width, height);
            grad.addColorStop(0, a);
            grad.addColorStop(1, b);
            ctx.fillStyle = grad;
            ctx.fill();
        }
        onWidthChanged: requestPaint()
        onHeightChanged: requestPaint()
    }

    ColumnLayout {
        anchors {
            fill: parent; margins: 18
            topMargin: 14; bottomMargin: 14
        }
        spacing: 6

        RowLayout {
            Layout.fillWidth: true
            Label {
                text: card.kicker
                color: Qt.rgba(1, 1, 1, 0.75)
                font { pixelSize: Theme.fontSizeMicro; weight: Theme.weightBold; letterSpacing: 1.4 }
                Layout.fillWidth: true
            }
            AbstractButton {
                id: dismissBtn
                width: 20; height: 20
                Layout.alignment: Qt.AlignTop
                contentItem: NavIcon {
                    name: "close"
                    color: dismissBtn.hovered ? "#FFFFFF" : Qt.rgba(1, 1, 1, 0.6)
                    width: 12; height: 12
                    anchors.centerIn: parent
                }
                background: Item {}
                onClicked: { card.dismissedNow = true; card.dismissed(); }
            }
        }

        Label {
            text: card.title
            color: "#FFFFFF"
            font { pixelSize: Theme.fontSizeLarge + 1; weight: Theme.weightBold }
            wrapMode: Text.WordWrap
            Layout.fillWidth: true
            Layout.fillHeight: true
            verticalAlignment: Text.AlignVCenter
        }

        AbstractButton {
            id: cardBtn
            visible: card.actionLabel.length > 0
            implicitWidth: Math.max(72, lbl.implicitWidth + 28)
            implicitHeight: 30
            // The reference uses a solid white pill on the gradient; dark text on
            // white is also the highest-contrast thing on the card.
            background: Rectangle {
                radius: 6
                color: cardBtn.down ? "#D8DEE6" : cardBtn.hovered ? "#EDF1F5" : "#FFFFFF"
            }
            contentItem: Label {
                id: lbl
                text: card.actionLabel
                color: "#17222E"
                font { pixelSize: Theme.fontSizeBody; weight: Theme.weightBold }
                horizontalAlignment: Text.AlignHCenter
                verticalAlignment: Text.AlignVCenter
            }
            onClicked: card.actionClicked()
        }
    }
}
